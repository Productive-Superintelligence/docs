---
interface Props {
    current?: "overview" | "psicli" | "psihub" | "tutorial" | "reference";
}

const { current = "overview" } = Astro.props;

const tabs = [
    { key: "overview", label: "Overview", href: "/docs" },
    { key: "psicli", label: "PsiCLI", href: "/docs/cli" },
    { key: "psihub", label: "PsiHub", href: "/docs/hub" },
    { key: "tutorial", label: "Tutorial", href: "/docs/tutorial" },
    { key: "reference", label: "Reference", href: "/docs/reference" },
];
---

<nav class="docs-switch docs-tabs" aria-label="Psi documentation sections">
    {tabs.map((tab) => (
        <a
            href={tab.href}
            class:list={[current === tab.key && "is-active"]}
            aria-current={current === tab.key ? "page" : undefined}
        >
            {tab.label}
        </a>
    ))}
</nav>
