---
interface Props {
    current?: "psi" | "lllm" | "sssn" | "aaax";
}

const { current = "psi" } = Astro.props;

const docs = [
    { key: "psi", label: "Psi", href: "/docs" },
    { key: "lllm", label: "LLLM · Low-Level Language Models", href: "https://lllm.one/" },
    { key: "sssn", label: "SSSN · Simple System of Systems Network", href: "https://sssn.one/" },
    { key: "aaax", label: "AAAX · Advanced Autonomous Agent Executor", href: "https://aaax.one/" },
];
---

<nav class="docs-switch docs-project-switch" aria-label="Documentation switcher">
    {docs.map((doc) => (
        <a
            href={doc.href}
            class:list={[current === doc.key && "is-active"]}
            aria-current={current === doc.key ? "page" : undefined}
        >
            {doc.label}
        </a>
    ))}
</nav>
