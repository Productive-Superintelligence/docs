---
interface Props {
    title?: string;
    layout?: "default" | "docs";
}

const { title = "Productive Superintelligence", layout = "default" } = Astro.props;
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=Space+Mono&display=swap" rel="stylesheet" />
    </head>
    <body class:list={[layout === "docs" && "docs-body"]}>
        <nav class="site-nav" aria-label="Primary">
            <a href="/" class="home-mark" aria-label="Productive Superintelligence home">
                <span class="home-psi" aria-hidden="true">ψ</span>
            </a>
            <div class="nav-links">
                <a href="/hub">Hub</a>
                <a href="/projects">Projects</a>
                <a href="/docs">Docs</a>
                <a href="/blog">Blog</a>
                <a href="/about">About</a>
            </div>
        </nav>

        <main class:list={[layout === "docs" && "docs-main"]}>
            <slot />
        </main>

        <footer>
            <p class="copyright">
                Productive Superintelligence &copy; <span id="copyright-year"></span>
            </p>
        </footer>

        <script>
            const start = 2026;
            const now = new Date().getFullYear();
            const year = document.getElementById("copyright-year");
            if (year) {
                year.textContent = now > start ? `${start} – ${now}` : `${start}`;
            }
        </script>
    </body>
</html>

<style is:global>
    :root {
        --bg: #fdfdfc;
        --text: #1a1a1a;
        --gray: #757575;
        --border: #e0ddd7;
        --font-serif: 'Newsreader', serif;
        --font-mono: 'Space Mono', monospace;
    }

    body {
        background-color: var(--bg);
        color: var(--text);
        font-family: var(--font-serif);
        margin: 0;
        padding: 0;
        display: flex;
        justify-content: center;
        min-height: 100vh;
        -webkit-font-smoothing: antialiased;
    }

    .site-nav {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 10;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 1.15rem 1.5rem;
        background: color-mix(in srgb, var(--bg) 92%, transparent);
        border-bottom: 1px solid color-mix(in srgb, var(--border) 70%, transparent);
        backdrop-filter: blur(10px);
    }

    .home-mark {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        color: var(--text);
        text-decoration: none;
    }

    .home-psi {
        font-family: var(--font-serif);
        font-size: 1.45rem;
        line-height: 1;
        font-style: italic;
    }

    .nav-links {
        display: flex;
        align-items: center;
        gap: 1.1rem;
        font-family: var(--font-mono);
        font-size: 0.7rem;
    }

    .nav-links a {
        color: var(--gray);
        text-decoration: none;
        transition: color 0.2s ease;
    }

    .nav-links a:hover,
    .nav-links a:focus-visible {
        color: var(--text);
    }

    main {
        width: 100%;
        max-width: 680px;
        padding: 120px 30px;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    .docs-main {
        align-items: stretch;
        max-width: 1040px;
        text-align: left;
    }

    header {
        margin-bottom: 4rem;
    }

    .symbol-container {
        position: relative;
        display: block;
        width: 95px;
        height: 95px;
        margin-bottom: 1rem;
        opacity: 0.85;
        color: inherit;
        text-decoration: none;
    }

    .psi-layer {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        overflow: visible;
    }

    .reveal-u,
    .reveal-i {
        stroke-dasharray: 100;
        stroke-dashoffset: 101;
        visibility: hidden;
    }

    .reveal-u {
        animation: sequence-u 3.5s ease-in-out infinite;
    }

    .reveal-i {
        animation: sequence-i 3.5s ease-in-out infinite;
    }

    @keyframes sequence-u {
        0%, 5% { stroke-dashoffset: 101; visibility: hidden; }
        6% { visibility: visible; }
        40%, 85% { stroke-dashoffset: 0; visibility: visible; }
        90%, 100% { stroke-dashoffset: -101; visibility: hidden; }
    }

    @keyframes sequence-i {
        0%, 40% { stroke-dashoffset: 101; visibility: hidden; }
        41% { visibility: visible; }
        70%, 85% { stroke-dashoffset: 0; visibility: visible; }
        90%, 100% { stroke-dashoffset: -101; visibility: hidden; }
    }

    h1 {
        font-size: 2.8rem;
        font-weight: 400;
        font-style: italic;
        letter-spacing: 0;
        margin: 0;
    }

    h2 {
        font-size: 1.65rem;
        font-weight: 400;
        font-style: italic;
        letter-spacing: 0;
        margin: 0 0 1rem;
    }

    hr {
        border: 0;
        border-top: 1px solid var(--border);
        width: 60px;
        margin: 2.5rem auto;
    }

    .manifesto {
        font-size: 1.4rem;
        line-height: 1.6;
        color: var(--text);
        margin: 0 auto 2rem auto;
        max-width: 560px;
        font-weight: 400;
    }

    .manifesto em {
        font-style: italic;
    }

    .repo-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5em;
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--gray);
        text-decoration: none;
        margin-bottom: 4rem;
        transition: color 0.2s ease;
    }

    .repo-link:hover,
    .repo-link:focus-visible {
        color: var(--text);
    }

    .repo-link .gh-icon {
        width: 13px;
        height: 13px;
    }

    .frameworks,
    .hub-panel,
    .quiet-section,
    .page-section,
    .docs-section {
        margin-bottom: 4rem;
        width: 100%;
    }

    .hub-panel,
    .quiet-section,
    .page-section,
    .docs-section {
        border-top: 1px solid var(--border);
        padding-top: 2rem;
    }

    .package-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1px;
        border: 1px solid var(--border);
    }

    .docs-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
        gap: 1px;
        border: 1px solid var(--border);
        margin-top: 2rem;
    }

    .package-block,
    .docs-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 1.5rem 1rem 1rem;
        color: var(--text);
        text-decoration: none;
        transition: background-color 0.2s ease;
        gap: 0.4rem;
    }

    .package-block + .package-block {
        border-left: 1px solid var(--border);
    }

    .package-block:hover,
    .package-block:focus-visible,
    .docs-card:hover,
    .docs-card:focus-visible {
        background-color: #f5f4f0;
    }

    .docs-card {
        align-items: flex-start;
        min-height: 9rem;
        padding: 1.15rem;
    }

    .package-logo {
        width: 100%;
        max-width: 140px;
        height: 40px;
        object-fit: contain;
        margin-bottom: 0.75rem;
        opacity: 0.85;
    }

    .package-desc {
        font-family: var(--font-serif);
        font-size: 0.75rem;
        color: var(--gray);
        font-style: italic;
    }

    .label {
        font-family: var(--font-mono);
        font-size: 0.65rem;
        text-transform: uppercase;
        letter-spacing: 0;
        color: var(--gray);
        margin-bottom: 1.2rem;
    }

    .section-copy {
        max-width: 560px;
        margin: 0 auto 1rem;
        color: var(--text);
        font-size: 1.05rem;
        line-height: 1.6;
    }

    .docs-main .section-copy {
        margin-left: 0;
        margin-right: 0;
    }

    .section-copy.muted {
        color: var(--gray);
        font-style: italic;
    }

    .text-link {
        font-family: var(--font-mono);
        font-size: 0.75rem;
        color: var(--text);
        text-decoration: none;
        border-bottom: 1px solid var(--text);
        padding-bottom: 0.15rem;
    }

    .link-row {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .docs-switch {
        align-items: center;
        border: 1px solid var(--border);
        display: grid;
        gap: 1px;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        margin: 0 0 2rem;
    }

    .docs-switch a {
        align-items: center;
        background: var(--bg);
        color: var(--gray);
        display: flex;
        font-family: var(--font-mono);
        font-size: 0.68rem;
        justify-content: center;
        line-height: 1.15;
        min-height: 2.6rem;
        padding: 0 0.65rem;
        text-align: center;
        text-decoration: none;
        white-space: normal;
    }

    .docs-switch a + a {
        border-left: 1px solid var(--border);
    }

    .docs-switch a:hover,
    .docs-switch a:focus-visible,
    .docs-switch a.is-active {
        background: #f5f4f0;
        color: var(--text);
    }

    code,
    pre {
        font-family: var(--font-mono);
    }

    pre {
        margin: 0.75rem 0 1rem;
        padding: 0.85rem 0.95rem;
        overflow-x: auto;
        border: 1px solid var(--border);
        background: #f5f4f0;
        color: var(--text);
        font-size: 0.7rem;
        line-height: 1.55;
        text-align: left;
        white-space: pre;
    }

    p code,
    .item-copy code {
        font-size: 0.78em;
        color: var(--text);
    }

    .page-list {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1px;
        border: 1px solid var(--border);
        margin-top: 2rem;
        text-align: left;
    }

    .page-list a,
    .page-list div {
        display: block;
        padding: 1.1rem 1.25rem;
        color: var(--text);
        text-decoration: none;
        background: transparent;
    }

    .page-list a + a,
    .page-list div + div {
        border-top: 1px solid var(--border);
    }

    .page-list a:hover,
    .page-list a:focus-visible {
        background: #f5f4f0;
    }

    .item-title {
        display: block;
        font-size: 1rem;
        margin-bottom: 0.35rem;
    }

    .docs-card .item-title {
        font-size: 1.05rem;
    }

    .item-copy {
        display: block;
        color: var(--gray);
        font-size: 0.9rem;
        line-height: 1.5;
    }

    footer {
        position: fixed;
        bottom: 0;
        width: 100%;
        text-align: center;
        padding: 1.5rem 0;
        pointer-events: none;
    }

    .copyright {
        font-family: var(--font-mono);
        font-size: 0.6rem;
        color: var(--border);
        margin: 0;
        letter-spacing: 0;
    }

    @media (max-width: 600px) {
        h1 { font-size: 2.2rem; }
        .manifesto { font-size: 1.2rem; }
        main { padding: 96px 24px 80px; }
        .site-nav {
            align-items: flex-start;
            gap: 1rem;
            padding: 0.9rem 1rem;
        }
        .nav-links {
            flex-wrap: wrap;
            justify-content: flex-end;
            gap: 0.65rem 0.9rem;
            max-width: 14rem;
        }
        .package-grid { grid-template-columns: 1fr; }
        .package-block + .package-block { border-left: none; border-top: 1px solid var(--border); }
        .docs-switch { grid-template-columns: repeat(2, minmax(0, 1fr)); }
        .docs-switch a + a { border-left: none; }
        .docs-switch a:nth-child(n + 3) { border-top: 1px solid var(--border); }
        .docs-switch a:last-child { grid-column: 1 / -1; }
    }
</style>
