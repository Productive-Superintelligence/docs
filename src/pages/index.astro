    </body>
</html>

<style>
    :root {
        --bg: #fdfdfc;           /* Warm, expensive paper white */
        --text: #1a1a1a;         /* Deep charcoal */
        --gray: #757575;         /* Soft secondary gray */
        --border: #e0ddd7;       /* Muted parchment border */
        --font-serif: 'Newsreader', serif;
        --font-mono: 'Space Mono', monospace;
    }

    body {
        background-color: var(--bg);
        color: var(--text);
        font-family: var(--font-serif);
        margin: 0;
        padding: 0;
        display: flex;
        justify-content: center;
        min-height: 100vh;
        -webkit-font-smoothing: antialiased;
    }

    main {
        width: 100%;
        max-width: 680px;
        padding: 120px 30px;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    header {
        margin-bottom: 4rem;
    }

    .symbol {
        font-size: 3.5rem;
        font-weight: 400;
        margin-bottom: 1rem;
        font-style: italic;
        opacity: 0.85;
    }

    h1 {
        font-size: 2.8rem;
        font-weight: 400;
        font-style: italic;
        letter-spacing: -0.02em;
        margin: 0;
    }

    hr {
        border: 0;
        border-top: 1px solid var(--border);
        width: 60px;
        margin: 2.5rem auto;
    }

    .manifesto {
        font-size: 1.4rem;
        line-height: 1.6;
        color: var(--text);
        margin: 0 auto 5rem auto;
        max-width: 560px;
        font-weight: 400;
    }

    .manifesto em {
        font-style: italic;
    }

    /* PACKAGES SECTION */
    .frameworks {
        margin-bottom: 4rem;
        width: 100%;
    }

    .package-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1px;
        border: 1px solid var(--border);
    }

    .package-block {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 2rem 1rem 1.5rem;
        color: var(--text);
        transition: background-color 0.2s ease;
        gap: 0.5rem;
    }

    .package-block + .package-block {
        border-left: 1px solid var(--border);
    }

    .package-block:hover {
        background-color: #f5f4f0;
    }

    .package-main-link {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        text-decoration: none;
        color: var(--text);
        flex: 1;
    }

    .package-gh-link {
        display: inline-flex;
        align-items: center;
        gap: 0.4em;
        font-family: var(--font-mono);
        font-size: 0.6rem;
        color: var(--gray);
        text-decoration: none;
        margin-top: 0rem;
        padding-bottom: 2px;
        border-bottom: 1px solid transparent;
        transition: border-color 0.2s ease, color 0.2s ease;
    }

    .package-gh-link:hover {
        color: var(--text);
        border-bottom-color: var(--border);
    }

    .gh-icon {
        width: 12px;
        height: 12px;
        fill: currentColor;
        flex-shrink: 0;
    }

    .package-logo {
        width: 100%;
        max-width: 140px;
        height: 40px;
        object-fit: contain;
        margin-bottom: 0.75rem;
        opacity: 0.85;
    }

    .package-desc {
        font-family: var(--font-serif);
        font-size: 0.75rem;
        color: var(--gray);
        font-style: italic;
    }

    /* ACTION SECTION */
    .action {
        margin-bottom: 4rem;
    }

    .label {
        font-family: var(--font-mono);
        font-size: 0.65rem;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        color: var(--gray);
        margin-bottom: 1.2rem;
    }

    .repo-link {
        font-family: var(--font-mono);
        font-size: 0.85rem;
        color: var(--text);
        text-decoration: none;
        padding-bottom: 4px;
        border-bottom: 1px solid var(--border);
        transition: border-color 0.3s ease, opacity 0.3s ease;
    }

    .repo-link:hover {
        border-color: var(--text);
        opacity: 0.7;
    }

    @media (max-width: 600px) {
        h1 { font-size: 2.2rem; }
        .manifesto { font-size: 1.2rem; }
        main { padding: 80px 24px; }
        .package-grid { grid-template-columns: 1fr; }
        .package-block + .package-block { border-left: none; border-top: 1px solid var(--border); }
    }
</style>