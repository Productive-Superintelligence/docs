---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout>
    <header>
        <a href="/" class="symbol-container" aria-label="Productive Superintelligence home">
            <svg viewBox="0 0 100 100" class="psi-layer">
                <defs>
                    <mask id="u-mask">
                        <path class="reveal-u" d="M 35 20 C 15 90, 80 80, 75 20" stroke="white" stroke-width="30" fill="none" stroke-linecap="butt" pathLength="100" />
                    </mask>
                </defs>
                <image href="/psi-u.svg" x="0" y="0" width="100" height="100" mask="url(#u-mask)" />
            </svg>

            <svg viewBox="0 0 100 100" class="psi-layer">
                <defs>
                    <mask id="i-mask">
                        <path class="reveal-i" d="M 38 90 L 60 20" stroke="white" stroke-width="25" fill="none" stroke-linecap="butt" pathLength="100" />
                    </mask>
                </defs>
                <image href="/psi-i.svg" x="0" y="0" width="100" height="100" mask="url(#i-mask)" />
            </svg>
        </a>
    </header>

    <article>
        <h1>Productive Superintelligence</h1>
        <hr />
        <p class="manifesto">
            <em>Connect, compose, expose</em>: open-source system-level
            frameworks for making autonomous parts recursively connectable.
        </p>
        <a href="https://github.com/productive-superintelligence" class="repo-link">
            <svg class="gh-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z" /></svg>
            github.com/productive-superintelligence
        </a>
    </article>

    <section class="frameworks">
        <p class="label">Flagship Frameworks</p>
        <p class="section-copy">
            Three small frameworks form one loop. SSSN connects systems, LLLM
            composes work, and AAAX exposes the composite as a service-ready
            surface that can connect again.
        </p>
        <div class="package-grid">
            <a href="https://sssn.one" class="package-block">
                <span class="package-desc">Connect / Channel</span>
                <img src="/sssn-logo-text-dark.png" alt="Simple System of Systems Network (SSSN)" class="package-logo" />
            </a>
            <a href="https://lllm.one" class="package-block">
                <span class="package-desc">Compose / Tactic</span>
                <img src="/lllm-logo-text-dark.png" alt="Low-Level Language Models (LLLM)" class="package-logo" />
            </a>
            <a href="https://aaax.one" class="package-block">
                <span class="package-desc">Expose / Strategy</span>
                <img src="/aaax-logo-text-dark.png" alt="Advanced Autonomous Agent Executor (AAAX)" class="package-logo" />
            </a>
        </div>
    </section>

    <section class="hub-panel" aria-labelledby="hub-title">
        <p class="label" id="hub-title">PsiHub</p>
        <p class="section-copy">
            PsiHub and PsiCLI sit beneath the loop: describe, validate,
            discover, and launch packages that keep one grammar at every scale.
        </p>
        <div class="link-row">
            <a href="/hub" class="text-link">Open PsiHub</a>
            <a href="/docs" class="text-link">Docs hub</a>
            <a href="/about" class="text-link">Design philosophy</a>
        </div>
    </section>
</SiteLayout>
