---
import DocsSwitcher from "../../components/DocsSwitcher.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";
import { readFileSync } from "node:fs";

const cliDoc = readFileSync(
    new URL("../../../../psicli/docs/prosi-cli.html", import.meta.url),
    "utf-8",
);
---

<SiteLayout title="PSI CLI Docs | Productive Superintelligence" layout="docs">
    <DocsSwitcher current="psicli" />
    <Fragment set:html={cliDoc} />
</SiteLayout>
